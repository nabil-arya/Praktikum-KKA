        "\n",
        "from abc import ABC, abstractmethod\n",
        "\n",
        "\n",
        "class KamarHotel(ABC):\n",
        "    def __init__(self, nama_kamar, harga_dasar):\n",
        "        self.nama_kamar = nama_kamar        # ini boleh diakses bebas\n",
        "        self.__harga_dasar = harga_dasar    # sengaja diprivate biar aman\n",
        "        self.__stok = 0                     # awalnya kosong, nanti diisi via tambah_stok()\n",
        "\n",
        "    # getter, soalnya __stok gak bisa diakses langsung dari luar\n",
        "    def get_stok(self):\n",
        "        return self.__stok\n",
        "\n",
        "    def get_harga_dasar(self):\n",
        "        return self.__harga_dasar\n",
        "\n",
        "    # ini bagian validasinya, sesuai soal stok gak boleh sampai minus\n",
        "    def tambah_stok(self, jumlah):\n",
        "        if jumlah < 0:\n",
        "            print(f\"Gagal update stok {self.nama_kamar}! Stok tidak boleh negatif ({jumlah}).\")\n",
        "        else:\n",
        "            self.__stok += jumlah\n",
        "            print(f\"Berhasil menambahkan stok {self.nama_kamar}: {jumlah} unit.\")\n",
        "\n",
        "    # dua method ini wajib diisi ulang sama class anak,\n",
        "    # soalnya cara hitung & nampilinnya beda tiap tipe kamar\n",
        "    @abstractmethod\n",
        "    def tampilkan_detail(self):\n",
        "        pass\n",
        "\n",
        "    @abstractmethod\n",
        "    def hitung_harga_total(self, jumlah_malam):\n",
        "        pass\n",
        "\n",
        "    # cuma helper biar angka rupiahnya rapi, dipakai bareng-bareng\n",
        "    # sama kedua child class (daripada nulis ulang tiap class)\n",
        "    def format_rupiah(self, angka):\n",
        "        return f\"Rp {angka:,.0f}\".replace(\",\", \".\")\n",
        "\n",
        "\n",
        "class KamarDeluxe(KamarHotel):\n",
        "    PAJAK = 0.10  # 10%\n",
        "\n",
        "    def __init__(self, nama_kamar, harga_dasar, fasilitas):\n",
        "        super().__init__(nama_kamar, harga_dasar)\n",
        "        self.fasilitas = fasilitas\n",
        "\n",
        "    def tampilkan_detail(self):\n",
        "        harga_dasar = self.get_harga_dasar()\n",
        "        pajak = harga_dasar * self.PAJAK\n",
        "        print(f\"[DELUXE] {self.nama_kamar} | Fasilitas: {self.fasilitas}\")\n",
        "        print(f\"   Harga Dasar/Malam: {self.format_rupiah(harga_dasar)} \"\n",
        "              f\"| Pajak(10%): {self.format_rupiah(pajak)}\")\n",
        "\n",
        "    def hitung_harga_total(self, jumlah_malam):\n",
        "        harga_dasar = self.get_harga_dasar()\n",
        "        pajak = harga_dasar * self.PAJAK\n",
        "        return (harga_dasar + pajak) * jumlah_malam\n",
        "\n",
        "\n",
        "class KamarStandard(KamarHotel):\n",
        "    PAJAK = 0.05  # 5%\n",
        "\n",
        "    def __init__(self, nama_kamar, harga_dasar, kapasitas):\n",
        "        super().__init__(nama_kamar, harga_dasar)\n",
        "        self.kapasitas = kapasitas\n",
        "\n",
        "    def tampilkan_detail(self):\n",
        "        harga_dasar = self.get_harga_dasar()\n",
        "        pajak = harga_dasar * self.PAJAK\n",
        "        print(f\"[STANDARD] {self.nama_kamar} | Kapasitas: {self.kapasitas}\")\n",
        "        print(f\"   Harga Dasar/Malam: {self.format_rupiah(harga_dasar)} \"\n",
        "              f\"| Pajak(5%): {self.format_rupiah(pajak)}\")\n",
        "\n",
        "    def hitung_harga_total(self, jumlah_malam):\n",
        "        harga_dasar = self.get_harga_dasar()\n",
        "        pajak = harga_dasar * self.PAJAK\n",
        "        return (harga_dasar + pajak) * jumlah_malam\n",
        "\n",
        "\n",
        "\n",
        "def proses_transaksi(daftar_pesanan):\n",
        "    total_tagihan = 0\n",
        "    print(\"--- STRUK PEMESANAN ---\")\n",
        "    for i, (kamar, malam) in enumerate(daftar_pesanan, start=1):\n",
        "        subtotal = kamar.hitung_harga_total(malam)\n",
        "        print(f\"{i}. \", end=\"\")\n",
        "        kamar.tampilkan_detail()\n",
        "        print(f\"   Menginap: {malam} malam | Subtotal: {kamar.format_rupiah(subtotal)}\")\n",
        "        total_tagihan += subtotal\n",
        "\n",
        "    print(\"-\" * 40)\n",
        "    print(f\"TOTAL TAGIHAN: {kamar.format_rupiah(total_tagihan)}\")\n",
        "    print(\"-\" * 40)\n",
        "    return total_tagihan\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    print(\"--- SETUP DATA KAMAR ---\")\n",
        "\n",
        "    # admin input 2 kamar dulu: 1 Deluxe, 1 Standard\n",
        "    deluxe1 = KamarDeluxe(\"Kamar Deluxe Sea View\", 1_500_000, \"Private Pool\")\n",
        "    standard1 = KamarStandard(\"Kamar Standard Superior\", 500_000, \"2 Orang\")\n",
        "\n",
        "    # stok Deluxe diisi normal, harusnya lancar\n",
        "    deluxe1.tambah_stok(10)\n",
        "\n",
        "    # nah ini bagian tesnya: admin salah input stok minus,\n",
        "    # program harus nolak (bukan malah error/crash)\n",
        "    standard1.tambah_stok(-5)\n",
        "\n",
        "    # baru dicoba lagi dengan angka yang benar\n",
        "    standard1.tambah_stok(20)\n",
        "\n",
        "    print()\n",
        "\n",
        "    # tamu booking: 2 malam Deluxe + 1 malam Standard sekaligus\n",
        "    daftar_pesanan = [\n",
        "        (deluxe1, 2),\n",
        "        (standard1, 1),\n",
        "    ]\n",
        "\n",
        "    # cetak struknya, sekalian dapet total tagihan akhir\n",
        "    proses_transaksi(daftar_pesanan)\n",
        "\n",
